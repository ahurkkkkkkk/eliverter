# Build artifacts and cross-compiled binaries.
# Every one of these is regenerated by the scripts in scripts/ - see the Build
# section in README.md. Shipping them would add ~250 MB of ELF to the repo and
# the FFmpeg trees are gigabytes more.
/third_party/
/bin/
/logs/
/android/build/
/android/app/src/main/libs/
/android/*.keystore

# Local scratch and editor state.
/.dev/
.DS_Store

# Web dependencies. The built bundle under go/internal/webui/dist IS committed:
# webui.go embeds it with go:embed, so a clone has to be able to compile without
# running npm first.
/web/node_modules/
